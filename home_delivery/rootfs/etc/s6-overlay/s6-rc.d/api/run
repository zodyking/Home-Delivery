#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Delivery - Python API (FastAPI + Playwright)
# ==============================================================================

API_PORT="8000"

bashio::log.info "============================================"
bashio::log.info "HOME DELIVERY API SERVICE v0.0.25"
bashio::log.info "============================================"
bashio::log.info "API Port: ${API_PORT}"

export PLAYWRIGHT_HEADLESS=true
export PYTHONUNBUFFERED=1
export DATA_DIR=/config

cd /app/python-service

bashio::log.info "Starting FastAPI server on port ${API_PORT}..."
exec python3 -m uvicorn main:app --host 0.0.0.0 --port "${API_PORT}"
